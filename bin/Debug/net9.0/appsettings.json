{
  "Ollama": {
    "Endpoint": "http://localhost:11434/api/generate",
    "Model": "gpt-oss:20b",
    "TimeoutSeconds": 300
  },
  "Ocr": {
    "TessDataPath": "./tessdata",
    "Language": "eng"
  },
  "ExtractionQuality": {
    "ManualReviewThreshold": 90,
    "MaxInputChars": 20000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}