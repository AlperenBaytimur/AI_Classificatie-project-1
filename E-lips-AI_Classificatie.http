@E_lips_AI_Classificatie_HostAddress = http://localhost:5280

POST {{E_lips_AI_Classificatie_HostAddress}}/api/extract
Content-Type: application/json

{
	"text": "Transport order: RelatieCode R123, 1 x 20FT container, bruto gewicht 18000, zegel ABC123. Pickup terminal Maasvlakte Rotterdam. Afleveren bij Bedrijf Test BV, Straatweg 1, 3011AA Rotterdam. Financieel: object transport, prijs 450 EUR, BTW code H, fin code T01."
}

###

POST {{E_lips_AI_Classificatie_HostAddress}}/api/extract/file
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="File"; filename="sample.eml"
Content-Type: message/rfc822

< ./samples/sample.eml
--boundary--

